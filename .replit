modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=8080 pnpm --filter @workspace/api-server run dev & PORT=21586 BASE_PATH=/ pnpm --filter @workspace/qr-course run dev"
waitForPort = 21586

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000

[[ports]]
localPort = 8080
externalPort = 80

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 9099
externalPort = 3001

[[ports]]
localPort = 18582
externalPort = 4200

[[ports]]
localPort = 21586
externalPort = 3000

[[ports]]
localPort = 22168
externalPort = 3003

[[ports]]
localPort = 24483
externalPort = 5000

[[ports]]
localPort = 26272
externalPort = 3002

[nix]
channel = "stable-25_05"
